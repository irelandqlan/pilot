#!/usr/bin/env bash
# ==============================================================================
# Pilot - Chromecast Remote & Voice Control CLI Utility
# ==============================================================================
set -euo pipefail

BOLD="\033[1m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"
DIM="\033[2m"
RESET="\033[0m"

SERVICES=("pilot-remote.service" "pilot-voice.service" "atvvoice.service")

print_banner() {
    echo -e "${BLUE}${BOLD}=== Pilot - Chromecast Remote & Voice Management ===${RESET}"
}

resolve_unit_name() {
    case "${1:-all}" in
        remote|pilot-remote|chromecast-remote) echo "pilot-remote.service" ;;
        voice|pilot-voice|chromecast-voice)   echo "pilot-voice.service" ;;
        atv|atvvoice)                         echo "atvvoice.service" ;;
        all)                                  echo "all" ;;
        *)                                    echo "$1" ;;
    esac
}

get_config_file() {
    if [ -n "${PILOT_CONFIG:-}" ] && [ -f "$PILOT_CONFIG" ]; then
        echo "$PILOT_CONFIG"
    elif [ -f "$HOME/.config/pilot/config.toml" ]; then
        echo "$HOME/.config/pilot/config.toml"
    elif [ -f "$HOME/.config/chromecast-remote/config.toml" ]; then
        echo "$HOME/.config/chromecast-remote/config.toml"
    elif [ -f "/usr/share/pilot/config.toml" ]; then
        echo "/usr/share/pilot/config.toml"
    else
        echo "$HOME/.config/pilot/config.toml"
    fi
}

is_service_active() {
    local s="$1"
    if systemctl --user is-active --quiet "$s"; then
        return 0
    fi
    # Check legacy name if applicable
    if [[ "$s" == "pilot-"* ]]; then
        local legacy="${s/pilot-/chromecast-}"
        systemctl --user is-active --quiet "$legacy"
        return $?
    fi
    return 1
}

cmd_status() {
    print_banner
    echo -e "${BOLD}Pilot Application:${RESET}"
    if is_service_active "pilot.service"; then
        pid=$(systemctl --user show --property MainPID --value "pilot.service" 2>/dev/null || echo "?")
        echo -e "  ${GREEN}●${RESET} ${BOLD}pilot.service${RESET}: ${GREEN}Active${RESET} (PID: $pid)"
    elif pgrep -f "io.github.magnotec.Pilot" >/dev/null 2>&1; then
        pid=$(pgrep -f "io.github.magnotec.Pilot" | head -n1)
        echo -e "  ${GREEN}●${RESET} ${BOLD}Pilot (Flatpak)${RESET}: ${GREEN}Running${RESET} (PID: $pid)"
    elif pgrep -x "pilot" >/dev/null 2>&1; then
        pid=$(pgrep -x "pilot" | head -n1)
        echo -e "  ${GREEN}●${RESET} ${BOLD}Pilot (Native Process)${RESET}: ${GREEN}Running${RESET} (PID: $pid)"
    else
        echo -e "  ${RED}○${RESET} ${BOLD}Pilot${RESET}: ${RED}Inactive${RESET}"
    fi

    echo -e "\n${BOLD}Background Workers:${RESET}"
    if pgrep -x "atvvoice" >/dev/null 2>&1; then
        pid=$(pgrep -x "atvvoice" | head -n1)
        echo -e "  ${GREEN}●${RESET} ${BOLD}atvvoice (BLE Audio Receiver)${RESET}: ${GREEN}Running${RESET} (PID: $pid)"
    else
        echo -e "  ${RED}○${RESET} ${BOLD}atvvoice (BLE Audio Receiver)${RESET}: ${RED}Inactive${RESET}"
    fi

    if pgrep -f "voice_daemon.py" >/dev/null 2>&1; then
        pid=$(pgrep -f "voice_daemon.py" | head -n1)
        echo -e "  ${GREEN}●${RESET} ${BOLD}voice_daemon (Speech-to-Text)${RESET}: ${GREEN}Running${RESET} (PID: $pid)"
    else
        echo -e "  ${RED}○${RESET} ${BOLD}voice_daemon (Speech-to-Text)${RESET}: ${RED}Inactive${RESET}"
    fi

    echo -e "\n${BOLD}Hardware & Bluetooth:${RESET}"
    if command -v bluetoothctl >/dev/null 2>&1; then
        dev_info=$(bluetoothctl devices 2>/dev/null | grep -i "Chromecast Remote" | head -n1 || true)
        if [ -n "$dev_info" ]; then
            mac=$(echo "$dev_info" | awk '{print $2}')
            name=$(echo "$dev_info" | cut -d' ' -f3-)
            if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
                echo -e "  ${GREEN}●${RESET} $name ($mac): ${GREEN}Connected${RESET}"
            else
                echo -e "  ${YELLOW}○${RESET} $name ($mac): ${YELLOW}Disconnected / Sleeping${RESET}"
            fi
        else
            echo -e "  ${YELLOW}!${RESET} No paired 'Chromecast Remote' found in bluetoothctl"
        fi
    fi

    echo -e "\n${BOLD}Permissions & Configuration:${RESET}"
    if [ -w /dev/uinput ]; then
        echo -e "  ${GREEN}✓${RESET} /dev/uinput: Read/Write Access Available"
    else
        echo -e "  ${RED}✗${RESET} /dev/uinput: Permission Denied"
    fi

    cfg=$(get_config_file)
    if [ -f "$cfg" ]; then
        echo -e "  ${GREEN}✓${RESET} Config File: $cfg"
    else
        echo -e "  ${YELLOW}!${RESET} Config File: not found (will be created on first launch)"
    fi
}

cmd_start() {
    echo -e "${CYAN}Starting Pilot...${RESET}"
    if systemctl --user is-enabled pilot.service >/dev/null 2>&1 || [ -f "$HOME/.config/systemd/user/pilot.service" ]; then
        systemctl --user start pilot.service
    elif command -v flatpak >/dev/null 2>&1 && flatpak list --app | grep -q "io.github.magnotec.Pilot"; then
        flatpak run io.github.magnotec.Pilot >/dev/null 2>&1 &
    elif command -v pilot >/dev/null 2>&1; then
        pilot >/dev/null 2>&1 &
    fi
    sleep 0.5
    cmd_status
}

cmd_stop() {
    echo -e "${YELLOW}Stopping Pilot and workers...${RESET}"
    systemctl --user stop pilot.service pilot-remote.service pilot-voice.service atvvoice.service 2>/dev/null || true
    pkill -f "io.github.magnotec.Pilot" 2>/dev/null || true
    pkill -x "pilot" 2>/dev/null || true
    pkill -x "atvvoice" 2>/dev/null || true
    pkill -f "voice_daemon.py" 2>/dev/null || true
    sleep 0.5
    cmd_status
}

cmd_restart() {
    cmd_stop
    sleep 0.5
    cmd_start
}

cmd_logs() {
    echo -e "${CYAN}Streaming Pilot logs (Ctrl+C to stop)...${RESET}"
    journalctl --user -f -u pilot.service -u pilot-remote.service -u pilot-voice.service -u atvvoice.service
}

cmd_doctor() {
    print_banner
    echo -e "${BOLD}Running System Diagnostics...${RESET}\n"
    
    echo -n "Checking /dev/uinput write permission: "
    if [ -w /dev/uinput ]; then
        echo -e "${GREEN}PASS${RESET}"
    else
        echo -e "${RED}FAIL${RESET} (Requires udev rule or membership in 'input' group)"
    fi

    echo -n "Checking Python 3 evdev module: "
    if python3 -c "import evdev" 2>/dev/null; then
        echo -e "${GREEN}PASS${RESET}"
    else
        echo -e "${RED}FAIL${RESET} (Install python3-evdev)"
    fi

    echo -n "Checking PipeWire daemon: "
    if systemctl --user is-active --quiet pipewire.service 2>/dev/null; then
        echo -e "${GREEN}PASS${RESET}"
    else
        echo -e "${YELLOW}WARN${RESET} (PipeWire user service not active)"
    fi

    echo -n "Checking Bluetooth service: "
    if systemctl is-active --quiet bluetooth.service 2>/dev/null; then
        echo -e "${GREEN}PASS${RESET}"
    else
        echo -e "${YELLOW}WARN${RESET} (Bluetooth service not active)"
    fi

    echo ""
    cmd_status
}

case "${1:-status}" in
    status)   cmd_status ;;
    start)    cmd_start "${2:-all}" ;;
    stop)     cmd_stop "${2:-all}" ;;
    restart)  cmd_restart "${2:-all}" ;;
    logs)     cmd_logs "${2:-all}" ;;
    doctor)   cmd_doctor ;;
    config)   echo "$(get_config_file)" ;;
    help|--help|-h)
        print_banner
        echo "Usage: pilot-ctl [status|start|stop|restart|logs|doctor|config]"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Usage: pilot-ctl [status|start|stop|restart|logs|doctor|config]"
        exit 1
        ;;
esac
