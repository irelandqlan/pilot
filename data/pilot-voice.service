[Unit]
Description=Pilot Voice Typing & Dictation Daemon
After=graphical-session.target pipewire.service atvvoice.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/pilot/voice_daemon.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
